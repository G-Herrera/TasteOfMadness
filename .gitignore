# User-specific files (Visual Studio / VSCode)
.vs/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Compiled object and intermediate files
*.slo
*.lo
*.o
*.obj
*.gch
*.pch

# Compiled libraries
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Unreal build folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/*

# ✅ Allow icon and whitelist PakBlacklist
!Build/**/*.ico
!Build/*/PakBlacklist*.txt

# Project files generated by the Engine
*.xcodeproj
*.xcworkspace

# Source art (optional, can be versioned separately)
SourceArt/**/*.png
SourceArt/**/*.tga

# Built data for maps (generated automatically)
*_BuiltData.uasset

# Cache and auto-generated data
*.aps
*.pch
*.pdb
*.idb

# Logs and autosaves
Saved/Logs/
Saved/Autosaves/
Saved/Config/Windows/EditorPerProjectUserSettings.ini
Saved/Config/Windows/Engine.ini
Saved/AutoScreenshot.png

# Plugin binaries and intermediates
Plugins/**/Binaries/*
Plugins/**/Intermediate/*

# Misc editor-specific caches
DerivedDataCache/*

/TasteOfMadness/Saved/
/TasteOfMadness/Intermediate/
                                                            
*.log
*.bin

# 🔒 Optional: Ignore local backup or temp maps
*_Auto*.umap
*_Auto*.uasset
*.tmp

