# Visual Studio user specific files
.vs/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Unreal build folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/*

# Allow icon and blacklist files
!Build/**/*.ico
!Build/*/PakBlacklist*.txt

# Engine generated project files
*.xcodeproj
*.xcworkspace

# Source art (optional)
SourceArt/**/*.png
SourceArt/**/*.tga

# Built data for maps
*_BuiltData.uasset

# Cache and auto-generated data
*.aps
*.pch
*.pdb
*.idb

# Ignore logs and autosaves
Saved/Logs/
Saved/Autosaves/

# Plugin binaries and intermediates
Plugins/**/Binaries/*
Plugins/**/Intermediate/*

# Misc
DerivedDataCache/*
TasteOfMadness/Saved/Logs/TasteOfMadness.log
